<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/note_background"
    android:clipToPadding="false"
    android:foreground="?android:selectableItemBackground"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/note_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/note_citationsNumber"
        android:ellipsize="end"
        android:maxLines="10"
        tools:text="Note text." />

    <TextView
        android:id="@+id/note_references"
        style="@style/AppTheme.ReferencesNumber"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-1dp"
        android:layout_marginEnd="-5dp"
        tools:text="12" />

    <TextView
        android:id="@+id/note_citationsNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="-5dp"
        android:background="@color/source_citation"
        android:paddingStart="4dp"
        android:paddingTop="1dp"
        android:paddingEnd="4dp"
        android:paddingBottom="1.5dp"
        android:textSize="13sp"
        tools:text="12" />

    <LinearLayout
        android:id="@+id/note_sources"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/note_text"
        android:orientation="vertical" />
</RelativeLayout>
