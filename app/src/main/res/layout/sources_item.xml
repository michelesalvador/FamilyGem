<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/source_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_text"
            android:textSize="15sp"
            tools:text="S0123" />

        <TextView
            android:id="@+id/source_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/source_id"
            android:layout_marginEnd="4dp"
            android:layout_toStartOf="@+id/source_image"
            android:ellipsize="end"
            android:maxLines="4"
            tools:text="This is a source title that takes multiple lines to display how it wraps.\nThird line\nAnd more" />

        <ImageView
            android:id="@+id/source_image"
            android:layout_width="60dp"
            android:layout_height="85dp"
            android:layout_alignParentEnd="true"
            android:scaleType="centerCrop"
            tools:src="@drawable/source_image" />

        <TextView
            android:id="@+id/source_num"
            style="@style/AppTheme.ReferencesNumber"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="-2dp"
            android:layout_marginEnd="-4dp"
            tools:text="123" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="?android:attr/listDivider" />
</LinearLayout>
