<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical">

    <TextView
        android:id="@+id/event_title"
        style="@style/AppTheme.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Event title" />

    <TextView
        android:id="@+id/event_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/event_title"
        android:textSize="17sp"
        tools:text="Event content text veeery long that reaches the end of the line and wraps." />

    <EditText
        android:id="@+id/event_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/event_title"
        android:textSize="17sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/event_alert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/event_title"
        android:layout_alignParentEnd="true"
        android:contentDescription="@string/invalid_date"
        android:visibility="gone"
        app:srcCompat="@drawable/alert" />

    <app.familygem.DateEditorLayout
        android:id="@+id/event_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/event_edit"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <app.familygem.AgeEditorLayout
        android:id="@+id/event_age"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/event_date"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/event_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/event_age"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/event_cancel"
            style="@style/AppTheme.NormalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/event_save"
            style="@style/AppTheme.ColoredButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/event_other"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/event_text"
        android:orientation="vertical" />
</RelativeLayout>
